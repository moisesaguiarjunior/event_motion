{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event Motion agent pipeline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "template", "title", "layout", "durationMs", "coverMs", "nodes", "links", "events"],
  "properties": {
    "version": {"const": 1},
    "template": {"const": "agent_pipeline"},
    "title": {"$ref": "#/$defs/copy", "maxLength": 36},
    "subtitle": {"$ref": "#/$defs/copy", "maxLength": 72},
    "layout": {"enum": ["diamond", "vertical"]},
    "durationMs": {"type": "integer", "minimum": 250, "maximum": 60000},
    "coverMs": {"$ref": "#/$defs/timeMs"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/node"}
    },
    "links": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/link"}
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "if": {"properties": {"layout": {"const": "diamond"}}},
  "then": {"properties": {"nodes": {"minItems": 4}}},
  "$defs": {
    "copy": {
      "type": "string",
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,23}$"
    },
    "timeMs": {"type": "integer", "minimum": 0, "maximum": 59999},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/copy", "maxLength": 18}
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atMs", "node", "status"],
      "properties": {
        "atMs": {"$ref": "#/$defs/timeMs"},
        "node": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "status": {"enum": ["idle", "active", "complete", "failed"]},
        "message": {"$ref": "#/$defs/copy", "maxLength": 48}
      }
    }
  }
}
